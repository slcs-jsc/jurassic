// Malformed JuMACS climatology: more latitude bands than the maximum
// CLAT supported by this version of JURASSIC.
netcdf bad_lat {
dimensions: month = 12 ; altitude = 5 ; lat = 120 ;
variables:
  float altitude(altitude) ;
    altitude:units = "km" ;
  float lat(lat) ;
    lat:units = "degrees_north" ;
  float temperature_mean(month, altitude, lat) ;
    temperature_mean:units = "K" ;
}
