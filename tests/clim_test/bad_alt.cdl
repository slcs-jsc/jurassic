// Malformed JuMACS climatology: more altitude levels than the maximum
// CZ supported by this version of JURASSIC.
netcdf bad_alt {
dimensions: month = 12 ; altitude = 250 ; lat = 4 ;
variables:
  float altitude(altitude) ;
    altitude:units = "km" ;
  float lat(lat) ;
    lat:units = "degrees_north" ;
  float temperature_mean(month, altitude, lat) ;
    temperature_mean:units = "K" ;
}
